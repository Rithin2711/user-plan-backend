# Mock Server Configuration Example
# Copy this file to .env and modify values as needed

# Server Configuration
HOST=0.0.0.0
PORT=3001

# Development Settings
RELOAD=true
LOG_LEVEL=info

# CORS Settings (for development - use specific origins in production)
CORS_ORIGINS=*

# Application Settings
APP_NAME=Mock User Plan Server
APP_VERSION=1.0.0
APP_DESCRIPTION=Mock backend server demonstrating plan-based API responses
